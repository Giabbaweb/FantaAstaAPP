{
  "name": "fantaastaapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "description": "FantaAstaAPP - applicazione locale per la gestione di un'asta di fantacalcio dal vivo",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm build:shared && pnpm --parallel --filter @fantaastaapp/server --filter @fantaastaapp/web dev",
    "dev:server": "pnpm --filter @fantaastaapp/server dev",
    "dev:web": "pnpm --filter @fantaastaapp/web dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm build:shared && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:generate": "pnpm --filter @fantaastaapp/server db:generate",
    "db:migrate": "pnpm --filter @fantaastaapp/server db:migrate",
    "build:shared": "pnpm --filter @fantaastaapp/contracts build && pnpm --filter @fantaastaapp/domain build"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
