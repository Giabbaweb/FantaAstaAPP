{
  "name": "@fantaastaapp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node scripts/dev-server-supervisor.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "emergency-recovery": "tsx src/emergency-recovery.ts"
  },
  "dependencies": {
    "@fantaastaapp/contracts": "workspace:*",
    "@fantaastaapp/domain": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.1",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.4.0",
    "pino": "10.3.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
